{
  "name": "@landasika/dshell",
  "version": "0.2.0",
  "description": "A Claude Code-style terminal frontend for DeepSeek Harness",
  "type": "module",
  "private": false,
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.27.1",
  "main": "./dist/plugin/index.js",
  "types": "./dist/plugin/index.d.ts",
  "bin": {
    "dshell": "./dist/bin/dshell.js"
  },
  "exports": {
    ".": {
      "types": "./dist/plugin/index.d.ts",
      "default": "./dist/plugin/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "default": "./dist/plugin/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "default": "./dist/protocol/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "clean": "rm -rf dist",
    "prepack": "pnpm build",
    "pack": "pnpm build && npm pack",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "cli",
    "tui",
    "agent",
    "terminal"
  ],
  "homepage": "https://github.com/Landasika/dshell#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Landasika/dshell.git"
  },
  "bugs": {
    "url": "https://github.com/Landasika/dshell/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
